rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasCollageMakerAccess(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && firestore.get(/databases/(default)/documents/accessUsers/$(uid)).data.active == true
        && firestore.get(/databases/(default)/documents/accessUsers/$(uid)).data.apps['1:379503088311:web:6a63dfcd8523e9f8133332'] == true
        && firestore.get(/databases/(default)/documents/appRegistry/1:379503088311:web:6a63dfcd8523e9f8133332).data.active == true;
    }

    match /users/{uid}/{allPaths=**} {
      allow read, write: if hasCollageMakerAccess(uid);
    }
  }
}
